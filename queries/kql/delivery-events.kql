// Starter KQL examples for an Eventhouse table named DeliveryEvents.
// Adapt field names and types to the table actually ingested.

DeliveryEvents
| summarize EventCount = count(),
            DistinctPackages = dcount(package_id)
  by bin(event_timestamp, 1h), event_status
| order by event_timestamp desc

// Duplicate event identity check
DeliveryEvents
| summarize Copies = count() by event_id
| where Copies > 1
| order by Copies desc

// Recent exception candidates. Define business statuses and time windows for your implementation.
DeliveryEvents
| where event_timestamp > ago(24h)
| where event_status in ("Delivery Exception", "Delayed", "Failed Attempt")
| project event_timestamp, package_id, order_id, carrier, event_location, event_status
| order by event_timestamp desc
